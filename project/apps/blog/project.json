

{
  "name": "blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/blog/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nrwl/webpack:webpack" ,
      "outputs":["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/blog",
        "main": "apps/blog/tsconfig.app.json",
        "assets": ["apps/blog/src/assets"],
        "generatePackageJson": true,
        "webpackConfig": "apps/blog/webpack.config.js"
      }
    },
    "buildImage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run blog:build",
          "docker build --file ./apps/blog/Dockerfile --tag readme.blog:1.0.0 ."
        ]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "blog:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "blog:build:development"
        },
        "production": {
          "buildTarget": "blog:build:production"
        }
      }
    },
    "db:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma validate --schema ./schema.prisma",
        "cwd": "libs/blog/models/prisma"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma migrate dev --schema ./schema.prisma --skip-generate --skip-seed",
        "cwd": "libs/blog/models/prisma"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma migrate reset --schema ./schema.prisma --force --skip-generate --skip-seed",
        "cwd": "libs/blog/models/prisma"
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma generate --schema ./schema.prisma",
        "cwd": "libs/blog/models/prisma"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node seed.ts",
        "cwd": "libs/blog/models/prisma"
      }
    }
  }
}
